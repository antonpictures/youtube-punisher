{
  "manifest_version": 3,
  "name": "YouTube Punisher",
  "version": "1.1.0",
  "description": "Auto-reloads YouTube pages when an ad plays, preserving your playback position. Punish the ads.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Punisher — Ad History"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}