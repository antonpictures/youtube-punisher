{
  "manifest_version": 3,
  "name": "YouTube Ad Reloader",
  "version": "1.0.0",
  "description": "Auto-reloads YouTube pages when an ad plays, preserving your playback position.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}